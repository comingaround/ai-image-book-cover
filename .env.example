# placeholder = filter-based fake styles (free). live = real Nano Banana calls.
AI_MODE=live
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Option A — Google AI Studio key (simplest; wins if set)
GEMINI_API_KEY=

# Option B — Vertex AI
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_USE_ADC=1          # local: uses `gcloud auth application-default login`
# VERTEX_ACCESS_TOKEN=    # or paste `gcloud auth print-access-token` (expires in 1h)
# Production on Vercel (keyless): workload identity pool trusting Vercel OIDC
# VERTEX_WORKLOAD_AUDIENCE=//iam.googleapis.com/projects/<PROJECT_NUMBER>/locations/global/workloadIdentityPools/<POOL>/providers/<PROVIDER>
# VERTEX_SERVICE_ACCOUNT_EMAIL=<name>@<project>.iam.gserviceaccount.com
